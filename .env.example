# 後端 API 位址（手機預覽請填電腦的區網 IP，非 localhost）
EXPO_PUBLIC_API_BASE_URL=

# 地圖渲染用（react-native-maps 原生 SDK 必須）
# 此金鑰會被打包進 App，務必在 Google Cloud Console 限制：
#   應用程式限制：Android 套件名 + SHA-1 / iOS Bundle ID
#   API 限制：只允許 Maps SDK / Places / Directions
EXPO_PUBLIC_GOOGLE_API_KEY=

# 註：天氣、TDX 大眾運輸皆改由後端代理，前端不再需要這些金鑰。