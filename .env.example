# ==========================================
# VibeTrip 前端 — 共用預設（正式 API）
# 複製成 .env 後填入；本機 dev 另建 .env.local 覆寫
# ==========================================

# 正式後端（EAS preview / production 也用此 URL，除非另建 .env.preview）
EXPO_PUBLIC_API_BASE_URL=https://vibetrip.codingraccoon.com

# development | preview | production（本機可省略，由 .env.local 或 script 決定）
EXPO_PUBLIC_APP_VARIANT=production

# Google Maps 原生 SDK（須在 GCP 限制套件名 / Bundle ID）
EXPO_PUBLIC_GOOGLE_API_KEY=
